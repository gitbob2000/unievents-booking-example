{
  "name": "unievents-booking",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "audit:ci": "npm audit --audit-level=high"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/dev/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
